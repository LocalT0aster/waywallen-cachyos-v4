# Maintainer: LocalT0aster <90502400+LocalT0aster@users.noreply.github.com>

pkgname=waywallen-open-wallpaper-engine
pkgver=0.2.3
pkgrel=1
pkgdesc='Wallpaper Engine renderer plugin for waywallen'
arch=('x86_64')
url='https://github.com/waywallen/open-wallpaper-engine'
license=('GPL-2.0-only')
depends=('ffmpeg' 'glibc' 'libglvnd' 'mesa' 'vulkan-icd-loader' 'waywallen>=0.3.3')
makedepends=('clang' 'cmake>=4.3.1' 'git' 'lld' 'ninja' 'pkgconf' 'vulkan-headers')
source=("open-wallpaper-engine-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('67567e2ff7ff525904fe99522a725f19b34e9fe1cef4f792120035fffcac250a')

build() {
  # CEF's wrapper target and C++ modules must share a compatible hardening profile.
  export CFLAGS="${CFLAGS/-Wp,-D_FORTIFY_SOURCE=3/}"
  export CXXFLAGS="${CXXFLAGS/-Wp,-D_FORTIFY_SOURCE=3/}"
  export CPPFLAGS="${CPPFLAGS/-D_FORTIFY_SOURCE=3/}"
  export CFLAGS="${CFLAGS//-flto=auto/}"
  export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
  export LDFLAGS="${LDFLAGS//-flto=auto/}"
  cmake -S "open-wallpaper-engine-${pkgver}" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_LINKER_TYPE=LLD \
    -DBUILD_TESTS=OFF \
    -DBUILD_VIEWER=OFF \
    -DBUILD_WAYWALLEN=ON \
    -DBUILD_WESCENE=ON \
    -DBUILD_WEWEB=ON
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "open-wallpaper-engine-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
